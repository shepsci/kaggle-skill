[0.100000, "o", "kaggle-skill MCP setup for Antigravity CLI\r\nremote endpoint: https://www.kaggle.com/mcp\r\n\r\n"]
[0.900000, "o", "$ mkdir -p .agents\r\n$ $EDITOR .agents/mcp_config.json\r\n"]
[2.300000, "o", "{\r\n  \"mcpServers\": {\r\n    \"kaggle\": {\r\n      \"serverUrl\": \"https://www.kaggle.com/mcp\",\r\n      \"headers\": {\r\n        \"Authorization\": \"Bearer <KAGGLE_API_TOKEN>\"\r\n      }\r\n    }\r\n  }\r\n}\r\n"]
[4.700000, "o", "\r\n$ agy\r\n> /mcp\r\n"]
[6.100000, "o", "MCP servers\r\n  kaggle  configured from .agents/mcp_config.json\r\n  status  ready after credential verification\r\n"]
[7.400000, "o", "\r\nTip: use serverUrl for Antigravity CLI remote MCP entries.\r\n"]
