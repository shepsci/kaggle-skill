# Example only. The skill reads a file like this ONLY when KAGGLE_ENV_FILE
# names it, and only the lines shown below (plus KAGGLE_CONFIG_DIR):
#
#   export KAGGLE_ENV_FILE="$HOME/.config/kaggle.env"
#
# Keep the real file outside any folder you publish, and never commit it.
# Prefer `kaggle auth login`, or the token file ~/.kaggle/access_token.

KAGGLE_API_TOKEN=paste-your-api-token-here

# Legacy key, for old tools only:
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_legacy_key
